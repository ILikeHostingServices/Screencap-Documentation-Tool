# Recordings and generated screenshots can contain passwords, license keys,
# internal hostnames, IP addresses, and other sensitive data. Never commit them.
source/*
!source/.gitkeep
output/*
!output/.gitkeep

# Any stray media anywhere in the repo
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.png
*.jpg
# ...except the application icon and the app's own screenshots and Snap Store
# images, which show only a made-up demo (packaging/screenshots/make_screenshots.sh)
!assets/icon.png
!docs/screenshots/*.png
!docs/store/*.png
*.jpeg
*.log

# Portable FFmpeg install (tools\ffmpeg\bin\ffmpeg.exe)
tools/

# Python / OS / editor clutter
__pycache__/
*.py[cod]
.venv/
venv/
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# Local secrets, just in case
.env
*.key
*.pem

# Optional speech recognition environment made by the installers
whisper-env/

# Packaged Windows app builds (PyInstaller)
build/
dist/

# Build output of the Office file checker used by the tests
tests/ooxml/bin/
tests/ooxml/obj/

# Test coverage data (CI writes these; see .coveragerc)
.coverage
.coverage.*
coverage-*.data
_site/
